#!/usr/bin/env python3
"""kbx entry point: resolve this script's symlinks, then run kbx.cli:main.

Install by linking it onto PATH, e.g. `ln -s "$PWD/bin/kbx" ~/.local/bin/kbx`.
"""

import os
import sys

if sys.version_info < (3, 11):
    sys.exit("kbx needs Python 3.11 or newer")

checkout = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, checkout)

from kbx.cli import main  # noqa: E402

sys.exit(main())
