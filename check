#!/usr/bin/env bash
# Lint, type-check and unit-test kbx. The dev tools are optional: missing ones
# are reported and skipped; kbx itself never needs them.
set -uo pipefail
cd "$(dirname "$0")" || exit 1
status=0
step() { printf '\n== %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1 || { echo "skipped: $1 not installed"; return 1; }; }

step ruff
if have ruff; then
  ruff check kbx kbx_sandbox tests modules bin/kbx image/bin || status=1
  ruff format --check kbx kbx_sandbox tests modules bin/kbx image/bin || status=1
fi

step pyright
if have pyright; then pyright || status=1; fi

step shellcheck
if have shellcheck; then
  mapfile -t scripts < <(
    { ls image/install-node image/update-codex-native host/*.sh host/install-firewall check
      find modules examples -type f \( -name '*.sh' -o -name service \) ; find modules -path '*/build/*' -type f; } |
      while read -r f; do head -1 "$f" | grep -qE '^#!.*\b(ba|da)?sh\b' && echo "$f"; done)
  shellcheck "${scripts[@]}" || status=1
fi

step "unit tests"
python3 -m unittest discover -s tests/unit -t . "$@" || status=1

step "clean environment (empty HOME, no config)"
tmp="$(mktemp -d)"
env -i PATH="$PATH" HOME="$tmp" LANG=C.UTF-8 python3 -m unittest discover -s tests/unit -t . 2>"$tmp.log" || { tail -20 "$tmp.log"; status=1; }
tail -3 "$tmp.log"; rm -f "$tmp.log"
rm -rf "$tmp"

exit "$status"
